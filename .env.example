# Copy to .env and fill in. Never commit .env.
#
# Minimum to answer questions locally with no Twilio wiring at all
# (`docker compose run --rm chat`): OPENAI_API_KEY. Leaving
# TWILIO_KNOWLEDGE_BASE_ID empty falls back to the offline fixture, which is a
# test double rather than real site content.
#
# Minimum to serve a channel: the Twilio credentials, one sender, and the
# Conversation Configuration. `scripts/provision.py` creates the rest.

# --- Twilio credentials ---
# Account SID and Auth Token are on the Console home page. Everything else here
# can be created from them by scripts/provision.py.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Scoped API key, used for every call except minting the key itself. Created by
# scripts/provision.py, which prints both values at creation. The secret is
# never readable again, so save it then.
TWILIO_API_KEY=
TWILIO_API_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Senders: at least one is required ---
# SMS-capable Twilio number, E.164. Leave empty for a WhatsApp-only setup; the
# SMS channel is then not registered. Sending SMS to US numbers needs toll-free
# verification or 10DLC registration first.
TWILIO_PHONE_NUMBER=

# WhatsApp sender, format whatsapp:+1234567890. The shared sandbox sender below
# needs no Meta Business verification and no approved sender, so it is the
# fastest way to a working channel. See the README for joining it.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Created by scripts/provision.py ---
# Filling these in makes a re-run reuse the resources rather than look them up
# by display name.
TWILIO_MEMORY_STORE_ID=
TWILIO_CONVERSATION_CONFIGURATION_ID=

# --- Knowledge base ---
# Enterprise Knowledge base holding the curesyngap1.org content snapshot. The
# agent answers from this and links every answer to a page on the site.
TWILIO_KNOWLEDGE_BASE_ID=know_knowledgebase_01m2gmmj26e35ty0xf2kkgfk16

# --- Agent tuning ---
# Luna. Cheap and fast enough for short SMS answers.
OPENAI_MODEL=gpt-5.6-luna
# Luna rejects function tools on /v1/chat/completions unless reasoning is off.
# Leave empty to omit the parameter for a model that does not accept it.
AGENT_REASONING_EFFORT=none
# Seconds before the agent gives up and sends the fallback reply.
AGENT_TIMEOUT_SECONDS=12
# Model turns allowed to call tools before a final answer is forced.
AGENT_MAX_TOOL_ITERATIONS=3
# Conversation Memory retrieval. "always" re-queries per message using the
# message as the relevance query, "once" caches per conversation, "never"
# disables recall and a returning family is met as a stranger.
#
# What memory may retain about a family is an open decision, not a settled
# policy: extraction is not selective, so a family describing seizures or
# medications would have that retained. See docs/decisions.md before changing
# this or pointing real families at the agent.
MEMORY_MODE=always
# Knowledge passages retrieved per search.
KB_TOP_K=5
# Relevance floor, 0 to 1. Semantic search returns its nearest matches for any
# question, so this drops the weak tail. Raise it if answers cite unrelated
# pages; lower it if the agent escalates questions the site does cover.
KB_MIN_SCORE=0.3

# --- Deployment ---
# Render API key, from Dashboard > Account Settings > API Keys. Needed only to
# manage the deployed service from the command line; the agent itself never
# reads it. `render.yaml` defines the service.
RENDER_API_KEY=

# Render workspace holding the service. `scripts/deploy.py` uses it to pick the
# right one when the same service name exists in more than one workspace. List
# them with:
#   curl -H "Authorization: Bearer $RENDER_API_KEY" https://api.render.com/v1/owners
RENDER_OWNER_ID=

# --- Optional ---
TWILIO_LOG_LEVEL=INFO
